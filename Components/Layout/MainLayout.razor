@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<header class="cabecera-app">
    <a class="marca" href="">
        <span class="marca-nombre">Otium</span>
        <span class="marca-lema">el arte de leer sin prisa</span>
    </a>

    <nav class="menu">
        <AuthorizeView>
            <Authorized>
                <NavLink href="estantes">Mis estantes</NavLink>
                <NavLink href="amigos">Amigos</NavLink>
                <NavLink href="glosario">Glosario</NavLink>
            </Authorized>
        </AuthorizeView>
        <BotonTema />
        <BotonInstalar />
        <MenuUsuario />
    </nav>
</header>

<main class="contenido">
    @Body
</main>

<footer class="pie-app">
    <a href="/privacidad">Privacidad</a>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">✕</span>
</div>
