@implements IAsyncDisposable
@inject IJSRuntime JS

@if (mostrarBoton)
{
    <button class="boton-instalar" @onclick="Instalar">Instalar Otium</button>
}

@if (mostrarModaliOS)
{
    <div class="modal-fondo" @onclick="() => mostrarModaliOS = false">
        <div class="modal-caja" @onclick:stopPropagation="true">
            <h3>Instalar Otium</h3>
            <ol>
                <li>Pulsa Compartir (el cuadrado con la flecha) en la barra de Safari.</li>
                <li>Elige Añadir a la pantalla de inicio.</li>
                <li>Pulsa Añadir.</li>
            </ol>
            <button class="boton secundario" @onclick="() => mostrarModaliOS = false">Entendido</button>
        </div>
    </div>
}

@code {
    private bool mostrarBoton;
    private bool mostrarModaliOS;
    private bool esIOS;
    private DotNetObjectReference<BotonInstalar>? referencia;

    protected override async Task OnAfterRenderAsync(bool primeraVez)
    {
        if (!primeraVez) return;

        var yaInstalada = await JS.InvokeAsync<bool>("otiumInstalador.yaInstalada");
        if (yaInstalada) return;

        esIOS = await JS.InvokeAsync<bool>("otiumInstalador.esIOS");
        if (esIOS)
        {
            mostrarBoton = true;
            StateHasChanged();
            return;
        }

        referencia = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("otiumInstalador.registrar", referencia);
    }

    [JSInvokable]
    public void MostrarBotonInstalar()
    {
        mostrarBoton = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OcultarBotonInstalar()
    {
        mostrarBoton = false;
        StateHasChanged();
    }

    private async Task Instalar()
    {
        if (esIOS)
        {
            mostrarModaliOS = true;
            return;
        }

        await JS.InvokeAsync<string>("otiumInstalador.mostrarPrompt");
        mostrarBoton = false;
    }

    public async ValueTask DisposeAsync()
    {
        try { referencia?.Dispose(); } catch { }
        await Task.CompletedTask;
    }
}
