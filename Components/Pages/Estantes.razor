@page "/"
@page "/estantes"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Otium.Models
@using Otium.Services
@inject ILibroService Servicio
@inject IEntradaLecturaService ServicioEntradas
@inject AuthenticationStateProvider ProveedorAuth
@inject NavigationManager Navegacion

<PageTitle>Mis estantes | Otium</PageTitle>

<h1>Mis estantes</h1>

@if (!string.IsNullOrEmpty(errorGeneral))
{
    <p class="error">@errorGeneral</p>
}

<div class="acciones">
    <button class="boton" @onclick="() => mostrarFormulario = !mostrarFormulario">
        @(mostrarFormulario ? "Cerrar" : "Añadir libro")
    </button>
</div>

@if (mostrarFormulario)
{
    <section class="ficha nuevo">
        <h2>Nuevo libro</h2>

        <BuscadorLibros TextoInicial="@textoBusqueda"
                        ResultadoSeleccionado="OnResultadoSeleccionado" />

        <FormularioLibro Titulo="@nuevoTitulo"
                         Autor="@nuevoAutor"
                         Estante="@nuevoEstante"
                         PortadaUrl="@nuevaPortada"
                         IdExterno="@nuevoIdExterno"
                         OnGuardar="OnGuardarLibro"
                         OnCancelar="CerrarFormulario" />
    </section>
}

<div class="disposicion">

    <section>
        <div class="pestanas">
            @foreach (var e in Enum.GetValues<Estante>())
            {
                <button class="pestana @(e == estanteActual ? "activa" : "")"
                        @onclick="() => IrAEstante(e)">
                    @Nombre(e) @libros.Count(l => l.Estante == e)
                </button>
            }
        </div>

        <RepisaLibros Libros="libros"
                      EstanteActual="estanteActual"
                      @bind-Vista="vista"
                      LibroSeleccionado="seleccionado"
                      LibroSeleccionadoChanged="OnLibroSeleccionado" />

        <p class="resumen">@Resumen()</p>
    </section>

    <section class="ficha">
        @if (seleccionado is Libro actual)
        {
            <FichaDetalleLibro Libro="@seleccionado"
                              UsuarioId="@usuarioId"
                              OnEstanteCambiado="OnEstanteCambiado"
                              OnPuntuacionCambiada="OnPuntuacionCambiada"
                              OnQuitarLibro="OnQuitarLibro" />

            <EditorResena Libro="@seleccionado"
                          UsuarioId="@usuarioId"
                          Entradas="entradasLectura"
                          OnGuardarReseña="OnGuardarReseña"
                          OnAñadirTravesía="OnAñadirTravesía"
                          OnQuitarTravesía="OnQuitarTravesía" />

            @if (seleccionado is Libro libroActual)
            {
                <button class="boton-travesias" @onclick="() => IrAGlosario(libroActual.Titulo)">
                    Buscar palabra desconocida
                </button>
            }
        }
        else
        {
            <p class="vacio">Elige un libro de la repisa para puntuarlo o escribir tu reseña.</p>
        }
    </section>

</div>

@code {
    private string usuarioId = "";
    private List<Libro> libros = new();
    private Estante estanteActual = Estante.Leido;
    private Libro? seleccionado;
    private string vista = "lomos";

    private bool mostrarFormulario;
    private string textoBusqueda = "";
    private string nuevoTitulo = "";
    private string nuevoAutor = "";
    private Estante nuevoEstante = Estante.QuieroLeer;
    private string nuevaPortada = "";
    private string nuevoIdExterno = "";
    private string errorFormulario = "";
    private string errorGeneral = "";

    private string errorEntrada = "";
    private HashSet<int> entradasExpandidas = new();
    private List<EntradaLectura> entradasLectura = new();

    protected override async Task OnInitializedAsync()
    {
        var estado = await ProveedorAuth.GetAuthenticationStateAsync();
        usuarioId = estado.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        libros = await Servicio.ObtenerDeUsuarioAsync(usuarioId);
        await Elegir(libros.FirstOrDefault(l => l.Estante == estanteActual));
    }

    private async Task Elegir(Libro? libro)
    {
        seleccionado = libro;
        entradasExpandidas = new();

        entradasLectura = libro is not null
            ? await ServicioEntradas.ObtenerDeLibroAsync(usuarioId, libro.Id)
            : new();
    }

    private async Task IrAEstante(Estante estante)
    {
        estanteActual = estante;
        await Elegir(libros.FirstOrDefault(l => l.Estante == estante));
    }

    private async Task OnLibroSeleccionado(Libro? libro)
    {
        await Elegir(libro);
    }

    private async Task OnGuardarLibro((string Titulo, string Autor, Estante Estante, string PortadaUrl, string IdExterno) datos)
    {
        var nuevo = new Libro
        {
            UsuarioId = usuarioId,
            Titulo = datos.Titulo,
            Autor = datos.Autor,
            Estante = datos.Estante,
            PortadaUrl = datos.PortadaUrl,
            IdExterno = datos.IdExterno
        };

        var (exito, mensaje, creado) = await Servicio.AgregarAsync(usuarioId, nuevo);

        if (!exito || creado is null)
        {
            errorFormulario = mensaje;
            return;
        }

        libros.Add(creado);
        estanteActual = datos.Estante;
        await Elegir(creado);
        CerrarFormulario();
    }

    private void OnResultadoSeleccionado(ResultadoLibro resultado)
    {
        nuevoTitulo = resultado.Titulo;
        nuevoAutor = resultado.Autor;
        nuevaPortada = resultado.PortadaUrl;
        nuevoIdExterno = resultado.IdExterno;
        textoBusqueda = "";
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
        nuevoTitulo = "";
        nuevoAutor = "";
        nuevoEstante = Estante.QuieroLeer;
        nuevaPortada = "";
        nuevoIdExterno = "";
        errorFormulario = "";
    }

    private async Task OnEstanteCambiado(Estante destino)
    {
        if (seleccionado is not null)
        {
            seleccionado.Estante = destino;
            estanteActual = destino;
            await Guardar(seleccionado);
        }
    }

    private async Task OnPuntuacionCambiada(int valor)
    {
        if (seleccionado is not null)
        {
            seleccionado.Puntuacion = valor;
            await Guardar(seleccionado);
        }
    }

    private async Task OnQuitarLibro()
    {
        if (seleccionado is not null && seleccionado.UsuarioId == usuarioId)
        {
            await Servicio.EliminarAsync(usuarioId, seleccionado.Id);

            libros.Remove(seleccionado);
            await Elegir(libros.FirstOrDefault(l => l.Estante == estanteActual));
        }
    }

    private void IrAGlosario(string titulo)
    {
        Navegacion.NavigateTo($"/glosario?libro={System.Web.HttpUtility.UrlEncode(titulo)}");
    }

    private async Task Guardar(Libro libro)
    {
        if (libro.UsuarioId != usuarioId)
            return;

        var (exito, mensaje) = await Servicio.ActualizarAsync(usuarioId, libro);
        errorGeneral = exito ? "" : mensaje;
    }

    private async Task OnGuardarReseña(string reseña)
    {
        if (seleccionado is not null)
        {
            seleccionado.Resena = reseña;
            await Guardar(seleccionado);
        }
    }

    private async Task OnAñadirTravesía((int? PaginaInicio, int? PaginaFin, string Resumen) datos)
    {
        if (seleccionado is null) return;

        errorEntrada = "";

        var (exito, mensaje, entrada) = await ServicioEntradas.AgregarAsync(
            usuarioId,
            seleccionado.Id,
            datos.PaginaInicio,
            datos.PaginaFin,
            datos.Resumen);

        if (!exito || entrada is null)
        {
            errorEntrada = mensaje;
            return;
        }

        entradasLectura.Add(entrada);
    }

    private async Task OnQuitarTravesía(int entradaId)
    {
        errorEntrada = "";

        if (!await ServicioEntradas.EliminarAsync(usuarioId, entradaId))
        {
            errorEntrada = "No se pudo quitar la travesía.";
            return;
        }

        var entrada = entradasLectura.FirstOrDefault(e => e.Id == entradaId);
        if (entrada is not null)
        {
            entradasLectura.Remove(entrada);
            entradasExpandidas.Remove(entradaId);
        }
    }

    private string Resumen()
    {
        var leidos = libros.Where(l => l.Estante == Estante.Leido).ToList();
        var puntuados = leidos.Where(l => l.Puntuacion > 0).ToList();

        if (puntuados.Count == 0)
            return $"{leidos.Count} leídos";

        var promedio = puntuados.Average(l => l.Puntuacion);
        return $"{leidos.Count} leídos, promedio {promedio:0.0} de 5";
    }

    private static string Nombre(Estante e) => e switch
    {
        Estante.Leyendo => "Leyendo",
        Estante.Leido => "Leídos",
        _ => "Quiero leer"
    };
}
