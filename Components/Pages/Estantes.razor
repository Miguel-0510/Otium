@page "/"
@page "/estantes"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Otium.Data
@using Otium.Models
@using Otium.Services
@inject IDbContextFactory<OtiumContext> Fabrica
@inject BuscadorLibros Buscador

<PageTitle>Mis estantes | Otium</PageTitle>

<h1>Mis estantes</h1>

<div class="acciones">
    <button class="boton" @onclick="() => mostrarFormulario = !mostrarFormulario">
        @(mostrarFormulario ? "Cerrar" : "Añadir libro")
    </button>
</div>

@if (mostrarFormulario)
{
    <section class="ficha nuevo">
        <h2>Nuevo libro</h2>

        <div class="busqueda">
            <label>
                Buscar por título o autor
                <input @bind="textoBusqueda" @bind:event="oninput" @onkeydown="TeclaBusqueda" placeholder="Rayuela Cortázar" />
            </label>
            <button class="boton" disabled="@buscando" @onclick="Buscar">
                @(buscando ? "Buscando..." : "Buscar")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(errorBusqueda))
        {
            <p class="error">@errorBusqueda</p>
        }

        @if (resultados.Count > 0)
        {
            <ul class="resultados">
                @foreach (var r in resultados)
                {
                    <li>
                        <button class="resultado" @onclick="() => ElegirResultado(r)">
                            @if (r.PortadaUrl != "")
                            {
                                <img src="@r.PortadaUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="sin-portada">Sin portada</span>
                            }
                            <span class="datos">
                                <strong>@r.Titulo</strong>
                                <span>@r.Detalle</span>
                            </span>
                        </button>
                    </li>
                }
            </ul>
        }

        <p class="nota">
            Datos y portadas de <a href="https://openlibrary.org" target="_blank" rel="noopener">Open Library</a>.
            Si no lo encuentras, escríbelo a mano.
        </p>

        <div class="campos">
            <label>
                Título
                <input @bind="nuevoTitulo" @bind:event="oninput" placeholder="La casa de los espíritus" />
            </label>
            <label>
                Autor
                <input @bind="nuevoAutor" @bind:event="oninput" placeholder="Isabel Allende" />
            </label>
            <label>
                Estante
                <select @bind="nuevoEstante">
                    @foreach (var e in Enum.GetValues<Estante>())
                    {
                        <option value="@e">@Nombre(e)</option>
                    }
                </select>
            </label>
        </div>

        @if (nuevaPortada != "")
        {
            <img class="miniatura" src="@nuevaPortada" alt="Portada elegida" />
        }

        @if (!string.IsNullOrEmpty(errorFormulario))
        {
            <p class="error">@errorFormulario</p>
        }

        <div class="acciones">
            <button class="boton" @onclick="Agregar">Guardar libro</button>
            <button class="boton secundario" @onclick="CerrarFormulario">Cancelar</button>
        </div>
    </section>
}

<div class="disposicion">

    <section>
        <div class="pestanas">
            @foreach (var e in Enum.GetValues<Estante>())
            {
                <button class="pestana @(e == estanteActual ? "activa" : "")"
                        @onclick="() => IrAEstante(e)">
                    @Nombre(e) @libros.Count(l => l.Estante == e)
                </button>
            }
        </div>

        <div class="repisa">
            @foreach (var libro in libros.Where(l => l.Estante == estanteActual))
            {
                <button class="lomo @(libro == seleccionado ? "elegido" : "")"
                        title="@libro.Titulo"
                        @onclick="() => Elegir(libro)">
                    <span>@libro.Titulo</span>
                </button>
            }

            @if (!libros.Any(l => l.Estante == estanteActual))
            {
                <p class="vacio">Este estante está vacío. Añade un libro para empezar.</p>
            }
        </div>

        <p class="resumen">@Resumen()</p>
    </section>

    <section class="ficha">
        @if (seleccionado is Libro actual)
        {
            <div class="cabecera">
                @if (actual.PortadaUrl != "")
                {
                    <img class="portada" src="@actual.PortadaUrl" alt="Portada de @actual.Titulo" />
                }
                <div>
                    <h2>@actual.Titulo</h2>
                    <p class="autor">@actual.Autor</p>
                </div>
            </div>

            <h3>Estante</h3>
            <div class="pestanas">
                @foreach (var e in Enum.GetValues<Estante>())
                {
                    <button class="pestana pequena @(actual.Estante == e ? "activa" : "")"
                            @onclick="() => Mover(actual, e)">
                        @Nombre(e)
                    </button>
                }
            </div>

            <h3>Tu puntuación</h3>
            <div class="estrellas">
                @for (var i = 1; i <= 5; i++)
                {
                    var valor = i;
                    <button class="estrella @(valor <= actual.Puntuacion ? "encendida" : "")"
                            aria-label="Puntuar con @valor"
                            @onclick="() => Puntuar(actual, valor)">
                        ★
                    </button>
                }
            </div>

            <h3>Tu reseña</h3>
            <textarea rows="4"
                      placeholder="Qué te dejó este libro"
                      @bind="actual.Resena"
                      @bind:after="() => Guardar(actual)"></textarea>
            <p class="nota">Tu reseña se guarda al salir del cuadro de texto.</p>

            <h3>Quitar</h3>
            @if (!confirmandoQuitar)
            {
                <button class="boton secundario" @onclick="() => confirmandoQuitar = true">Quitar del diario</button>
            }
            else
            {
                <p class="error">¿Seguro que quieres quitar este libro? No se puede deshacer.</p>
                <div class="acciones">
                    <button class="boton peligro" @onclick="() => Quitar(actual)">Sí, quitar</button>
                    <button class="boton secundario" @onclick="() => confirmandoQuitar = false">Cancelar</button>
                </div>
            }
        }
        else
        {
            <p class="vacio">Elige un libro de la repisa para puntuarlo o escribir tu reseña.</p>
        }
    </section>

</div>

@code {
    private List<Libro> libros = new();
    private Estante estanteActual = Estante.Leido;
    private Libro? seleccionado;
    private bool confirmandoQuitar;

    private bool mostrarFormulario;
    private string nuevoTitulo = "";
    private string nuevoAutor = "";
    private Estante nuevoEstante = Estante.QuieroLeer;
    private string nuevaPortada = "";
    private string nuevoIdExterno = "";
    private string errorFormulario = "";

    private string textoBusqueda = "";
    private List<ResultadoLibro> resultados = new();
    private bool buscando;
    private string errorBusqueda = "";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Fabrica.CreateDbContextAsync();
        libros = await db.Libros.OrderBy(l => l.Id).ToListAsync();
        seleccionado = libros.FirstOrDefault(l => l.Estante == estanteActual);
    }

    private void Elegir(Libro? libro)
    {
        seleccionado = libro;
        confirmandoQuitar = false;
    }

    private void IrAEstante(Estante estante)
    {
        estanteActual = estante;
        Elegir(libros.FirstOrDefault(l => l.Estante == estante));
    }

    private async Task Guardar(Libro libro)
    {
        await using var db = await Fabrica.CreateDbContextAsync();
        db.Libros.Update(libro);
        await db.SaveChangesAsync();
    }

    private async Task Puntuar(Libro libro, int valor)
    {
        libro.Puntuacion = valor;
        await Guardar(libro);
    }

    private async Task Mover(Libro libro, Estante destino)
    {
        libro.Estante = destino;
        estanteActual = destino;
        await Guardar(libro);
    }

    private async Task TeclaBusqueda(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Buscar();
    }

    private async Task Buscar()
    {
        errorBusqueda = "";
        resultados = new();

        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            errorBusqueda = "Escribe un título o un autor para buscar.";
            return;
        }

        buscando = true;
        try
        {
            resultados = await Buscador.BuscarAsync(textoBusqueda);

            if (resultados.Count == 0)
                errorBusqueda = "No encontré resultados. Prueba con otras palabras o escríbelo a mano.";
        }
        catch (Exception)
        {
            errorBusqueda = "No pude consultar el buscador ahora. Puedes escribir el libro a mano.";
        }
        finally
        {
            buscando = false;
        }
    }

    private void ElegirResultado(ResultadoLibro r)
    {
        nuevoTitulo = r.Titulo;
        nuevoAutor = r.Autor;
        nuevaPortada = r.PortadaUrl;
        nuevoIdExterno = r.IdExterno;
        resultados = new();
        errorBusqueda = "";
    }

    private async Task Agregar()
    {
        if (string.IsNullOrWhiteSpace(nuevoTitulo))
        {
            errorFormulario = "Escribe el título del libro.";
            return;
        }

        var nuevo = new Libro
        {
            Titulo = nuevoTitulo.Trim(),
            Autor = nuevoAutor.Trim(),
            Estante = nuevoEstante,
            PortadaUrl = nuevaPortada,
            IdExterno = nuevoIdExterno
        };

        await using (var db = await Fabrica.CreateDbContextAsync())
        {
            db.Libros.Add(nuevo);
            await db.SaveChangesAsync();
        }

        libros.Add(nuevo);
        estanteActual = nuevoEstante;
        Elegir(nuevo);
        CerrarFormulario();
    }

    private async Task Quitar(Libro libro)
    {
        await using (var db = await Fabrica.CreateDbContextAsync())
        {
            db.Libros.Remove(libro);
            await db.SaveChangesAsync();
        }

        libros.Remove(libro);
        Elegir(libros.FirstOrDefault(l => l.Estante == estanteActual));
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
        nuevoTitulo = "";
        nuevoAutor = "";
        nuevoEstante = Estante.QuieroLeer;
        nuevaPortada = "";
        nuevoIdExterno = "";
        errorFormulario = "";
        textoBusqueda = "";
        resultados = new();
        errorBusqueda = "";
    }

    private string Resumen()
    {
        var leidos = libros.Where(l => l.Estante == Estante.Leido).ToList();
        var puntuados = leidos.Where(l => l.Puntuacion > 0).ToList();

        if (puntuados.Count == 0)
            return $"{leidos.Count} leídos";

        var promedio = puntuados.Average(l => l.Puntuacion);
        return $"{leidos.Count} leídos, promedio {promedio:0.0} de 5";
    }

    private static string Nombre(Estante e) => e switch
    {
        Estante.Leyendo => "Leyendo",
        Estante.Leido => "Leídos",
        _ => "Quiero leer"
    };
}