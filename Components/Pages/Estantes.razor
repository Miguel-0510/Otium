@page "/Estantes"
@rendermode InteractiveServer
@using Otium.Models

<PageTitle>Mis estantes | Otium</PageTitle>

<h1>Mis estantes</h1>

<div class="pestanas">
    @foreach (var e in Enum.GetValues<Estante>())
    {
        <button class="pestana @(e == estanteActual ? "activa" : "")"
                @onclick="() => estanteActual = e">
            @Nombre(e) @libros.Count(l => l.Estante == e)
        </button>
    }
</div>

<div class="repisa">
    @foreach (var libro in libros.Where(l => l.Estante == estanteActual))
    {
        <button class="lomo" title="@libro.Titulo" @onclick="() => seleccionado = libro">
            <span>@libro.Titulo</span>
        </button>
    }
</div>

@if (seleccionado is not null)
{
    <p class="detalle">@seleccionado.Titulo, de @seleccionado.Autor</p>
}

@code {
    private Estante estanteActual = Estante.Leido;
    private Libro? seleccionado;

    private readonly List<Libro> libros = new()
    {
        new() { Id = 1, Titulo = "Cien años de soledad", Autor = "Gabriel García Márquez", Estante = Estante.Leido, Puntuacion = 5 },
        new() { Id = 2, Titulo = "Pedro Páramo", Autor = "Juan Rulfo", Estante = Estante.Leido, Puntuacion = 4 },
        new() { Id = 3, Titulo = "El amor en los tiempos del cólera", Autor = "Gabriel García Márquez", Estante = Estante.Leyendo },
        new() { Id = 4, Titulo = "La vorágine", Autor = "José Eustasio Rivera", Estante = Estante.QuieroLeer },
        new() { Id = 5, Titulo = "Rayuela", Autor = "Julio Cortázar", Estante = Estante.QuieroLeer }
    };

    private static string Nombre(Estante e) => e switch
    {
        Estante.Leyendo => "Leyendo",
        Estante.Leido => "Leídos",
        _ => "Quiero leer"
    };
}