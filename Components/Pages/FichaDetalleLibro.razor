@using Otium.Models

<section class="ficha">
    @if (Libro is not null)
    {
        <div class="cabecera">
            @if (!string.IsNullOrEmpty(Libro.PortadaUrl))
            {
                <img class="portada" src="@Libro.PortadaUrl" alt="Portada de @Libro.Titulo" />
            }
            <div>
                <h2>@Libro.Titulo</h2>
                <p class="autor">@Libro.Autor</p>
            </div>
        </div>

        <h3>Estante</h3>
        <div class="pestanas">
            @foreach (var e in Enum.GetValues<Estante>())
            {
                <button class="pestana pequena @(Libro.Estante == e ? "activa" : "")"
                        @onclick="() => CambiarEstante(e)">
                    @Nombre(e)
                </button>
            }
        </div>

        <h3>Tu puntuación</h3>
        <div class="estrellas">
            @for (var i = 1; i <= 5; i++)
            {
                var valor = i;
                <button class="estrella @(valor <= Libro.Puntuacion ? "encendida" : "")"
                        aria-label="Puntuar con @valor"
                        @onclick="() => Puntuar(valor)">★</button>
            }
        </div>
    }
    else
    {
        <p class="vacio">Elige un libro de la repisa para puntuarlo o escribir tu reseña.</p>
    }
</section>

@code {
    [Parameter]
    public Libro? Libro { get; set; }

    [Parameter]
    public string UsuarioId { get; set; } = "";

    [Parameter]
    public EventCallback<Estante> OnEstanteCambiado { get; set; }

    [Parameter]
    public EventCallback<int> OnPuntuacionCambiada { get; set; }

    private void CambiarEstante(Estante destino)
    {
        _ = OnEstanteCambiado.InvokeAsync(destino);
    }

    private void Puntuar(int valor)
    {
        _ = OnPuntuacionCambiada.InvokeAsync(valor);
    }

    private static string Nombre(Estante e) => e switch
    {
        Estante.Leyendo => "Leyendo",
        Estante.Leido => "Leídos",
        _ => "Quiero leer"
    };
}
