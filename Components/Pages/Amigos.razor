@page "/amigos"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Otium.Services
@inject IAmistadService Servicio
@inject AuthenticationStateProvider ProveedorAuth
@inject IJSRuntime JS

<PageTitle>Amigos | Otium</PageTitle>

<h1>Amigos</h1>

<section class="ficha">
    <h2>Tu código</h2>
    <p class="nota">Compártelo con tus amigos para que te agreguen.</p>
    <div class="codigo-amigo">
        <span class="codigo-amigo-texto">@codigo</span>
        <button class="boton secundario sm" @onclick="CopiarCodigo">@(copiado ? "Copiado ✓" : "Copiar")</button>
    </div>
</section>

<section class="ficha">
    <h2>Privacidad</h2>
    <label class="opcion-compartir">
        <input type="checkbox" @bind="compartirEstantes" @bind:after="GuardarCompartir" />
        Compartir mis estantes con mis amigos
    </label>
    <p class="nota">Tus amigos podrán ver tus libros, puntuaciones y reseñas. Tus travesías y tu glosario siguen siendo privados.</p>
    @if (!string.IsNullOrEmpty(mensajePrivacidad))
    {
        <p class="@(privacidadExito ? "nota" : "error")">@mensajePrivacidad</p>
    }
</section>

<section class="ficha">
    <h2>Agregar un amigo</h2>
    <div class="busqueda">
        <label>
            Código de tu amigo
            <input @bind="codigoIngresado" @bind:event="oninput" placeholder="K7XQ2M9P" />
        </label>
        <button class="boton" @onclick="Enviar">Enviar solicitud</button>
    </div>
    @if (!string.IsNullOrEmpty(mensajeEnvio))
    {
        <p class="@(envioExitoso ? "nota" : "error")">@mensajeEnvio</p>
    }
</section>

@if (pendientes.Count > 0)
{
    <section class="ficha">
        <h2>Solicitudes pendientes <span class="contador-badge">@pendientes.Count</span></h2>
        <ul class="lista-amigos">
            @foreach (var s in pendientes)
            {
                <li>
                    <span class="avatar-amigo">@Iniciales(s.Correo)</span>
                    <span class="amigo-info">
                        <strong>@s.Correo</strong>
                        <span class="estado-pendiente">Quiere ser tu amigo</span>
                    </span>
                    <span class="acciones-lista">
                        <button class="boton sm" @onclick="() => Responder(s.Id, true)">Aceptar</button>
                        <button class="boton secundario sm" @onclick="() => Responder(s.Id, false)">Rechazar</button>
                    </span>
                </li>
            }
        </ul>
    </section>
}

<section class="ficha">
    <h2>Tus amigos <span class="contador-badge">@amigos.Count</span></h2>
    @if (amigos.Count == 0)
    {
        <p class="vacio">Todavía no tienes amigos agregados. Comparte tu código para empezar.</p>
    }
    else
    {
        <ul class="lista-amigos">
            @foreach (var a in amigos)
            {
                <li>
                    <span class="avatar-amigo">@Iniciales(a.Correo)</span>
                    <span class="amigo-info">
                        <strong>@a.Correo</strong>
                        <span class="estado-pendiente">@(a.ComparteEstantes ? "Comparte sus estantes" : "No comparte sus estantes")</span>
                    </span>
                    <span class="acciones-lista">
                        @if (a.ComparteEstantes)
                        {
                            <a class="boton secundario sm" href="/amigos/@a.UsuarioId">Ver estantes</a>
                        }
                        <button class="boton secundario sm" @onclick="() => EliminarAmigo(a)">Eliminar</button>
                        <button class="boton secundario sm" @onclick="() => Bloquear(a)">Bloquear</button>
                    </span>
                </li>
            }
        </ul>
    }
</section>

@if (bloqueados.Count > 0)
{
    <section class="ficha">
        <h2>Usuarios bloqueados <span class="contador-badge">@bloqueados.Count</span></h2>
        <ul class="lista-amigos">
            @foreach (var b in bloqueados)
            {
                <li>
                    <span class="avatar-amigo">@Iniciales(b.Correo)</span>
                    <span class="amigo-info">
                        <strong>@b.Correo</strong>
                        <span class="estado-pendiente">No puede enviarte solicitudes ni ver tus estantes.</span>
                    </span>
                    <span class="acciones-lista">
                        <button class="boton secundario sm" @onclick="() => Desbloquear(b)">Desbloquear</button>
                    </span>
                </li>
            }
        </ul>
    </section>
}

@if (!string.IsNullOrEmpty(mensajeAccion))
{
    <p class="@(accionExito ? "nota" : "error")">@mensajeAccion</p>
}

@code {
    private string usuarioId = "";
    private string codigo = "";
    private string codigoIngresado = "";
    private string mensajeEnvio = "";
    private bool envioExitoso;
    private bool copiado;
    private bool compartirEstantes;
    private string mensajePrivacidad = "";
    private bool privacidadExito;
    private string mensajeAccion = "";
    private bool accionExito;
    private List<SolicitudPendiente> pendientes = new();
    private List<AmigoInfo> amigos = new();
    private List<BloqueadoInfo> bloqueados = new();

    protected override async Task OnInitializedAsync()
    {
        var estado = await ProveedorAuth.GetAuthenticationStateAsync();
        usuarioId = estado.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        codigo = await Servicio.ObtenerOCrearCodigoAsync(usuarioId);
        compartirEstantes = await Servicio.ObtenerCompartirEstantesAsync(usuarioId);
        await Recargar();
    }

    private async Task Recargar()
    {
        pendientes = await Servicio.ObtenerSolicitudesPendientesAsync(usuarioId);
        amigos = await Servicio.ObtenerAmigosAsync(usuarioId);
        bloqueados = await Servicio.ObtenerBloqueadosAsync(usuarioId);
    }

    private async Task GuardarCompartir()
    {
        privacidadExito = await Servicio.EstablecerCompartirEstantesAsync(usuarioId, compartirEstantes);
        mensajePrivacidad = privacidadExito
            ? "Preferencia guardada."
            : "No se pudo guardar la preferencia.";

        if (!privacidadExito)
        {
            compartirEstantes = await Servicio.ObtenerCompartirEstantesAsync(usuarioId);
        }

        await Recargar();
    }

    private async Task EliminarAmigo(AmigoInfo amigo)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar a {amigo.Correo} de tus amigos?"))
        {
            return;
        }

        var (exito, mensaje) = await Servicio.EliminarAmigoAsync(usuarioId, amigo.UsuarioId);
        accionExito = exito;
        mensajeAccion = mensaje;
        await Recargar();
    }

    private async Task Bloquear(AmigoInfo amigo)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Bloquear a {amigo.Correo}? Se eliminará la amistad y no podrá enviarte solicitudes."))
        {
            return;
        }

        var (exito, mensaje) = await Servicio.BloquearAsync(usuarioId, amigo.UsuarioId);
        accionExito = exito;
        mensajeAccion = mensaje;
        await Recargar();
    }

    private async Task Desbloquear(BloqueadoInfo bloqueado)
    {
        var (exito, mensaje) = await Servicio.DesbloquearAsync(usuarioId, bloqueado.UsuarioId);
        accionExito = exito;
        mensajeAccion = mensaje;
        await Recargar();
    }

    private async Task CopiarCodigo()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", codigo);
        copiado = true;
    }

    private async Task Enviar()
    {
        var (exito, mensaje) = await Servicio.EnviarSolicitudAsync(usuarioId, codigoIngresado);
        envioExitoso = exito;
        mensajeEnvio = mensaje;
        if (exito)
        {
            codigoIngresado = "";
        }
    }

    private async Task Responder(int solicitudId, bool aceptar)
    {
        await Servicio.ResponderSolicitudAsync(solicitudId, usuarioId, aceptar);
        await Recargar();
    }

    private static string Iniciales(string correo)
    {
        if (string.IsNullOrWhiteSpace(correo)) return "?";
        return correo[0].ToString().ToUpper();
    }
}
