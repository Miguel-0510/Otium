@page "/Error"
@using System.Diagnostics

<PageTitle>Error | Otium</PageTitle>

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Ocurrió un error al procesar tu solicitud.</h2>

@if (ShowRequestId)
{
    <p>
        <strong>ID de solicitud:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Cambiar a <strong>Desarrollo</strong> mostrará información más detallada sobre el error ocurrido.
</p>
<p>
    <strong>El modo Desarrollo no debe habilitarse en aplicaciones desplegadas.</strong>
    Puede mostrar información sensible de excepciones a los usuarios finales.
    Para depurar localmente, habilita <strong>Desarrollo</strong> estableciendo la variable de entorno <strong>ASPNETCORE_ENVIRONMENT</strong> a <strong>Development</strong>
    y reinicia la aplicación.
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
