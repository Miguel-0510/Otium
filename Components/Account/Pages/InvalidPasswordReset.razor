@page "/Account/InvalidPasswordReset"

<PageTitle>Enlace no válido | Otium</PageTitle>

<section class="cuenta">
    <h1>Enlace no válido</h1>
    <p role="alert">
        El enlace para restablecer la contraseña no es válido o ya caducó.
    </p>
    <p class="enlace-alterno">
        <a href="Account/ForgotPassword">Solicitar un enlace nuevo</a>
    </p>
</section>
