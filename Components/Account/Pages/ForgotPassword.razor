@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using Otium.Services

@inject IRecuperacionContrasenaService Recuperacion
@inject IEnlacePublicoService Enlaces
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ForgotPassword> Logger

<PageTitle>Recuperar contraseña | Otium</PageTitle>

<section class="cuenta">
    <h1>¿Olvidaste tu contraseña?</h1>
    <p class="subtitulo">Escribe tu correo y te enviaremos un enlace para elegir una nueva.</p>

    <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />

        <div class="campo">
            <label for="Input.Email">Correo electrónico</label>
            <InputText @bind-Value="Input.Email" id="Input.Email" type="email" autocomplete="username" aria-required="true" placeholder="nombre@correo.com" />
            <ValidationMessage For="() => Input.Email" class="text-danger" />
        </div>

        <button type="submit" class="boton-cuenta">Enviar enlace</button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(MensajeError))
    {
        <div class="mensaje-error">@MensajeError</div>
    }

    <p class="enlace-alterno">
        <a href="Account/Login">Volver a iniciar sesión</a>
    </p>
</section>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private string? MensajeError { get; set; }

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    private async Task OnValidSubmitAsync()
    {
        MensajeError = null;

        var resetUri = Enlaces.Construir(
            "Account/ResetPassword",
            new Uri(NavigationManager.BaseUri));

        try
        {
            await Recuperacion.SolicitarAsync(Input.Email, resetUri);
            RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error al solicitar recuperación de contraseña para {Email}", Input.Email);
            MensajeError = "No se pudo enviar el enlace de recuperación. Inténtalo de nuevo más tarde.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Escribe tu correo.")]
        [EmailAddress(ErrorMessage = "Escribe un correo válido.")]
        public string Email { get; set; } = "";
    }
}
